# Tec-C Brain — every environment variable the backend reads. Copy to `agent/.env` (git-ignored) and fill in.
# Load it with:   uvicorn tecc_brain.app:app --env-file .env      (run from agent/; uvicorn[standard] ships dotenv)
# Every key is OPTIONAL: anything left commented out falls back to the offline, deterministic demo behaviour.
# Uncomment a line only when you give it a value (an empty `KEY=` is NOT the same as unset).

# --- AI Brain: the single-pass synthesis model (graph/brain.py, graph/brain_llm.py) -------------------------
# Any OpenAI-compatible chat-completions endpoint. Both URL and KEY must be set to turn the model on.
# Example (Grok): TECC_BRAIN_LLM_URL=https://api.x.ai/v1/chat/completions
# TECC_BRAIN_LLM_URL=
# TECC_BRAIN_LLM_KEY=
TECC_BRAIN_LLM_MODEL=grok-4

# --- Agent 1: upgraded News Risk Sentinel (sentinel/*) — used by /api/mandate/propose AND /evaluate_options ---
# CMC_API_KEY=
# GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4
# COINGLASS_API_KEY=
COINGLASS_API_URL=https://open-api-v3.coinglass.com/api

# --- API access & security (api/deps.py) ---------------------------------------------------------------------
# Unset: the API only answers this machine (loopback). Set it before exposing the API on a network.
# TECC_API_TOKEN=
TECC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TECC_ALLOWED_HOSTS=
# 0 (demo default): draft rate limits and injection strikes follow the ACCOUNT only, so judges sharing one
# Wi-Fi never lock each other out. 1: also meter per client IP (use once accounts are authenticated).
TECC_RATELIMIT_BY_CLIENT=0

# --- Learned profiles --------------------------------------------------------------------------------------
# TECC_STATE_DIR=

# --- Hourly portfolio monitor (monitor/hourly.py) ----------------------------------------------------------
TECC_ENABLE_HOURLY_MONITOR=0
TECC_MONITOR_ACCOUNTS=demo
TECC_MONITOR_SCENARIO=demo
TECC_MONITOR_INTERVAL_MINUTES=60

# --- On-chain (onchain/*) ----------------------------------------------------------------------------------
TECC_NETWORK=anvil
TECC_ANVIL_RPC_URL=http://127.0.0.1:8545
# TECC_FOUNDRY_OUT=
