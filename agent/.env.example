# Tec-C Brain — every environment variable the backend reads. Copy to `agent/.env` (git-ignored) and fill in.
# Load it with:   uvicorn tecc_brain.app:app --env-file .env      (run from agent/; uvicorn[standard] ships dotenv)
# Every key is OPTIONAL: anything left commented out falls back to the offline, deterministic demo behaviour.
# Uncomment a line only when you give it a value (an empty `KEY=` is NOT the same as unset).

# --- AI Brain: the single-pass synthesis model (graph/brain.py, graph/brain_llm.py) -------------------------
# Set the KEY to turn the model on. The provider follows the model name: gemini-* → Google's OpenAI-compatible
# endpoint (Google AI Studio key), anything else → xAI. TECC_BRAIN_LLM_URL only overrides that endpoint.
# TECC_BRAIN_LLM_KEY=
TECC_BRAIN_LLM_MODEL=gemini-3.8-flash
# TECC_BRAIN_LLM_URL=
# Gemini only: thinking level (minimal / low / medium / high). "low" keeps the verdict inside the 8 s timeout.
TECC_BRAIN_REASONING_EFFORT=low

# --- Agent 1: upgraded News Risk Sentinel (sentinel/*) — used by /api/mandate/propose AND /evaluate_options ---
# CMC_API_KEY=
# GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4.20-0309-non-reasoning
# GROK_RESPONSES_URL=https://api.x.ai/v1/responses
# Live X Search for the Sentinel's X-pulse calls (billed per post: $5 per 1,000). Also switchable at runtime from
# the Settings screen: GET /api/settings, PUT /api/settings/x-search {"enabled": true}.
TECC_ENABLE_X_SEARCH=false
# COINGLASS_API_KEY=
COINGLASS_API_URL=https://open-api-v3.coinglass.com/api

# --- API access & security (api/deps.py) ---------------------------------------------------------------------
# Unset: the API only answers this machine (loopback). Set it before exposing the API on a network.
# TECC_API_TOKEN=
TECC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TECC_ALLOWED_HOSTS=
# 0 (demo default): draft rate limits and injection strikes follow the ACCOUNT only, so judges sharing one
# Wi-Fi never lock each other out. 1: also meter per client IP (use once accounts are authenticated).
TECC_RATELIMIT_BY_CLIENT=0

# --- Learned profiles --------------------------------------------------------------------------------------
# TECC_STATE_DIR=

# --- Hourly portfolio monitor (monitor/hourly.py) ----------------------------------------------------------
TECC_ENABLE_HOURLY_MONITOR=0
TECC_MONITOR_ACCOUNTS=demo
TECC_MONITOR_SCENARIO=demo
TECC_MONITOR_INTERVAL_MINUTES=60

# --- On-chain (onchain/*) ----------------------------------------------------------------------------------
TECC_NETWORK=anvil
TECC_ANVIL_RPC_URL=http://127.0.0.1:8545
# TECC_FOUNDRY_OUT=
# TECC_AUTO_START_FISCO=0            (1 = start the local FISCO BCOS node with the API; default 1 when TECC_NETWORK=fisco_bcos)
# TECC_STOP_FISCO_ON_SHUTDOWN=0
# FISCO_BCOS_RPC_URL=

# --- Privacy audit anchors on FISCO BCOS (onchain/anchoring.py) ------------------------------------------------
# All three set → de-pegs, executed arbitrage and Morning Review notes are anchored (hash only). Unset → each
# result reports audit_anchor status "not_configured". RPC and key default to the fisco_bcos market file.
# TECC_AUDIT_ANCHOR_ADDRESS=
# TECC_AUDIT_ANCHOR_RPC_URL=
# TECC_AUDIT_ANCHOR_KEY=

# --- Virtual session: phone access (virtual_session/*) ---------------------------------------------------------
# The wallet account the phone acts for (one owner per laptop).
TECC_VIRTUAL_SESSION_ACCOUNT=demo
# TECC_VIRTUAL_SESSION_DB=           (default agent/.tecc_data/virtual_sessions.sqlite3)
# TECC_STEPUP_SECRET=
# TECC_TUNNEL_URL=
# TECC_SPAWN_CLOUDFLARED=
# CLOUDFLARED_BIN=
# RP_ID=
